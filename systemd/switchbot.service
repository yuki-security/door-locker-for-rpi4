[Unit]
Description=Door Locker SwitchBot LINE Bot
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/door-locker-for-rpi4
ExecStart=/home/pi/door-locker-for-rpi4/venv/bin/python3 /home/pi/door-locker-for-rpi4/app.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
