# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
BOT_BASIC_ID=@your_bot_basic_id
ADMIN_USER_ID=your_admin_line_user_id

# Web dashboard
SECRET_DASHBOARD_KEY=change-me-long-random-string
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-dashboard-password

# Dynamic QR (30-minute rotating key)
TOTP_SECRET=change-me-totp-secret

# SwitchBot Open API
SWITCHBOT_TOKEN=your_switchbot_api_token
SWITCHBOT_SECRET=your_switchbot_api_secret
DEVICE_ID=your_switchbot_lock_device_id
HUB_DEVICE_ID=your_switchbot_hub_or_meter_device_id

# Static fallback passphrase (optional; QR uses rotating KEY_ values)
AUTH_SECRET_KEY=change-me-static-auth-key

# Public HTTPS URL used by LINE and SwitchBot webhooks (ngrok static domain recommended)
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.dev
WEBHOOK_URL=https://your-subdomain.ngrok-free.dev/switchbot-webhook

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
